@{
    Layout = "_AdminLayout";
}

@model List<SliderGetModel>


<section id="ProductList">
    
<div class="mb-3 d-flex justify-content-end">
    <a asp-controller="Slider" asp-action="Create" class="btn btn-dark shadow-sm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Slider Ekle
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th >Id</th>
                <th>Resim</th>
                <th>Başlık</th>
                <th>Açıklama</th>
                <th>Aktif</th>
                <th style="width: 90px"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var slider in Model)
            {
                <tr>
                    <td>@slider.Id</td>
                    <td>
                        <div class="mx-auto ratio ratio-1x1 overflow-hidden rounded" 
                             style="width: 80px;">
                            <img src="/images/@slider.ResimUrl" 
                                 class="img-fluid w-100 h-100 object-fit-cover" 
                                 alt="">
                        </div>
                    </td>
                    
                    <td>@slider.Baslik</td>
                    <td>@slider.Aciklama</td>
                    
                    <td>
                        @if (slider.Aktif)
                        {
                            <i class="fa-solid fa-circle-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-xmark text-danger"></i>
                        }
                    </td>
                    
                    <td>
                        <a asp-controller="Slider" asp-action="Edit" asp-route-id="@slider.Id"
                           class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-controller="Slider" asp-action="Delete" asp-route-id="@slider.Id"
                           class="btn btn-danger btn-sm">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</section>