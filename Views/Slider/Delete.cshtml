@{

   Layout="_AdminLayout"; 
}
@model Slider

<section id="SliderDelete">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header py-1 d-flex justify-content-between align-items-center">
                        <h5 class="card-title">Slider Sil</h5>
                    </div>
                    <div class="card-body">

                        <form asp-action="DeleteConfirm" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="alert alert-danger" role="alert">
                                <h4 class="alert-heading">Dikkat!</h4>
                                <p>Bu işlemi geri alamazsınız. @Model.Baslik İsimli Slider'ı silmek istediğinize emin misiniz?</p>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-10 offset-sm-2">
                                    <button type="submit" class="btn btn-danger">Sil</button>
                                    <a asp-controller="Slider" asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
                                </div>
                            </div>
                        </form>   

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>