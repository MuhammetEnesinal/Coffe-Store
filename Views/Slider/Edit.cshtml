@model SliderEditModel

@{
    Layout = "_AdminLayout";
}
@section Scripts{
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<section id="SliderEdit">
    <div class="container">
    
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ResimUrl" />
            
            <div class="row">
                <div class="col-md-9">
                    <div class="card shadow">
                    
                        <div class="card-header py-1 d-flex justify-content-between align-items-center">
                            <h5 class="card-title">Slider Düzenle</h5>

                            <div class="card-tools">
                                <a asp-controller="Slider" asp-action="Index" class="btn btn-sm btn-secondary">
                                    <i class="fa-solid fa-arrow-left me-2"></i> Geri Dön
                                </a>
                            </div>
                        </div> 
                        
                        <div class="card-body"> 
                            <div asp-validation-summary="All" class="text-danger"></div>
                            
                            <div class="row mb-3">
                                <label asp-for="Baslik" class="col-sm-2 col-form-label"></label>
                                <div class="col-sm-10">
                                    <input asp-for="Baslik" class="form-control">
                                    <span asp-validation-for="Baslik" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label asp-for="Aciklama" class="col-sm-2 col-form-label"></label>
                                <div class="col-sm-10">
                                    <textarea asp-for="Aciklama" rows="3" class="form-control"></textarea>
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <label asp-for="Aktif" class="col-sm-2 col-form-label"></label>
                                <div class="col-sm-10">
                                    <input asp-for="Aktif" class="form-check-input">
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-10 offset-sm-2">
                                    <button type="submit" class="btn btn-primary">Güncelle</button>
                                </div>
                            </div>

                        </div> </div> </div> <div class="col-md-3">
                    <div class="card shadow">
                        <div class="card-body">
                            <img src="~/images/@Model.ResimUrl" class="img-thumbnail" alt="">
                            <input asp-for="Resim" class="form-control mt-3">
                            <span asp-validation-for="Resim" class="text-danger"></span>
                        </div>
                    </div>
                </div> 
            </div> 
        </form>
    </div>
</section>