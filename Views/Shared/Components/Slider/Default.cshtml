@model List<CoffeStore.Models.Slider>

<div class="d-flex justify-content-center my-4">
    <div id="carouselCompact" class="carousel slide w-50" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{
                var first = true;
                foreach (var item in Model)
                {
                    var activeClass = first ? "active" : "";
                    first = false;
            
            <div class="carousel-item @activeClass">
                
                <div class="ratio ratio-16x9">
                    <img src="/images/@item.ResimUrl" class="d-block w-100 h-100 object-fit-cover" alt="@item.Baslik">
                </div>

                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 p-2 rounded">
                    <h6 class="mb-1">@item.Baslik</h6>
                    <small>@item.Aciklama</small>
                </div>
            </div>
            }
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselCompact" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselCompact" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

        
    </div>
</div>