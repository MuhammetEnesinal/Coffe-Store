
@{
    Layout = "_AdminLayout";
}

@model List<KategoriGetModel>


<section id="KategoriList">

    <div>
        <div class="mb-3 d-flex justify-content-end">
            <a asp-controller="Kategori" asp-action="Create" class="btn btn-dark shadow-sm px-4 py-2">
                <i class="fa-solid fa-plus me-2"></i> Kategori Ekle
            </a>
        </div>
    </div>
  
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th >Id</th>
                    <th>Kategori Adı</th>
                    <th>Url</th>
                    <th>Ürün Sayısı</th>
                    <th width="90"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var kategori in Model)
                {
                    <tr>
                        <td>@kategori.Id</td>
                        <td>@kategori.KategoriAdi</td>
                        <td>@kategori.Url</td>
                        <td>@kategori.UrunSayisi</td>
                        <td>
                            <a asp-controller="Kategori" asp-action="Edit" asp-route-id="@kategori.Id"
                               class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <a asp-controller="Kategori" asp-action="Delete" asp-route-id="@kategori.Id"
                               class="btn btn-danger btn-sm">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

</section>
                         
    
