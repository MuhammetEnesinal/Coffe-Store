@{

Layout="_Layout";

}
@model AccountChangePasswordModel

<section id="ChangePassword" class="mb-3">
    <div class="container">
        <div class="row ">

            @await Html.PartialAsync("~/Views/Shared/Partials/Site/_AccountEditUser.cshtml")

        
        
            <div class="col-md-9  mt-3 mb-3">
                <div class="card shadow border-0">
                    <div class="card-header bg-dark text-white text-center">
                        <h3 class="mb-0">
                            <i class="bi bi-person-circle me-2"></i> Parola Değiştir
                        </h3>
                    </div>

                    <div class="card-body">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <form asp-action="ChangePassword" method="post">
                            <!-- Mevcut Şifre -->
                            <div class="mb-3">
                                <label asp-for="OldPassword" class="form-label"></label>
                                <input asp-for="OldPassword" class="form-control" placeholder="Mevcut şifrenizi girin" />
                                <span asp-validation-for="OldPassword" class="text-danger"></span>
                            </div>

                          
                            <div class="mb-3">
                                <label asp-for=Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Yeni şifrenizi girin" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni şifrenizi tekrar girin" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                        
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <button type="submit" class="btn btn-dark flex-fill">Parolayı Değiştir</button>
                                <a asp-action="EditUser" class="btn btn-outline-dark flex-fill">Hesap Bilgilerine Dön</a>
                            </div>
                        </form>
                    </div>
            </div>
        </div>
    </div>


</section>