

@model AccountResetPasswordModel 
<section id="UserForgotPassword" class="py-5" style="background-color: #f8f9fa;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card shadow border-0">
          <div class="card-header bg-dark text-white text-center">
            <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Şifre Sıfırlama</h3>
          </div>

          <div class="card-body">
         
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

          
              <div class="mb-3">
                  <label asp-for="Password"></label>
                  <input asp-for="Password" class="form-control" />
                  <span asp-validation-for="Password" class="text-danger"></span>
              </div>

               <div class="mb-3">
                  <label asp-for="ConfirmPassword"></label>
                  <input asp-for="ConfirmPassword" class="form-control" />
                  <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
              </div>

              
              <div class="d-flex flex-wrap justify-content-between gap-2">
                <button type="submit" class="btn btn-dark flex-fill"> Gönder</button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark flex-fill">Geri Dön</a>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
