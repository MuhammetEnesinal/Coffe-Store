
<section id="UserForgotPassword" class="py-5" style="background-color: #f8f9fa;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card shadow border-0">
          <div class="card-header bg-dark text-white text-center">
            <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Şifremi Unuttum</h3>
          </div>

          <div class="card-body">
         
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
       
          
              <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" id="email" name="email" class="form-control" />
              </div>

              
              <div class="d-flex flex-wrap justify-content-between gap-2">
                <button type="submit" class="btn btn-dark flex-fill"> Gönder</button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark flex-fill">Geri Dön</a>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
