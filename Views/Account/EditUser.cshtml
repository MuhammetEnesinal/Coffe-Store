@{

Layout="_Layout";

}

@model AccountEditUserModel

<section id="EditUser" class="mb-3">
    <div class="container">

        <div class="row">

            @await Html.PartialAsync("~/Views/Shared/Partials/Site/_AccountEditUser.cshtml")



            <div class="col-md-9 mt-3 mb-3">
                <div class="card shadow border-0">
                    <div class="card-header bg-dark text-white text-center">
                        <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Bilgiler</h3>
                    </div>

                    <div class="card-body">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                            <form asp-action="EditUser" method="post">
                    
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <!-- Şifre -->
                            <div class="mb-3">
                                <label asp-for="AdSoyad" class="form-label"></label>
                                <input asp-for="AdSoyad"" class="form-control">
                                <span asp-validation-for="AdSoyad" class="text-danger"></span>

                            </div>


                            
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <button type="submit" class="btn btn-dark flex-fill">Güncelle</button>
                            </div>
                            </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>