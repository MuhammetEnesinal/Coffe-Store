@model List<Urun>



<div class="container-fluid">
  <div class="row flex-column flex-md-row">
    
    
   @await Html.PartialAsync("Partials/Site/_Menu", ViewData["Kategoriler"] as List<Kategori>)
 
   
       <div class="col p-4">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if(Model.Count == 0)
        {
            <div class="alert alert-danger w-100">
                <p class="text-center">Ürün bulunamadı.</p>
            </div>
        }
        @foreach (var urun in Model)
        {
         <div class="col">
         
        
            <div class="card text-center h-100">
          
          <!-- Sabit oranlı resim alanı -->
          <div class="ratio ratio-1x1">
            <img src="/images/@urun.ResimUrl" class="card-img-top" style="object-fit: cover;" alt="@urun.UrunAdi">
          </div>

          <div class="card-body">
            <h5 class="card-title">@urun.UrunAdi</h5>
            <p class="card-text">@urun.Aciklama</p>
            <p class="fw-bold">@urun.Fiyat₺</p>
          </div>

          <div class="card-body">
            <a asp-controller="Cart" asp-action="AddToCart" asp-route-urunId="@urun.Id" class="btn btn-dark">Sepete Ekle</a>
            <a asp-controller="Urun" asp-action="Details" asp-route-id="@urun.Id" class="btn btn-outline-dark">Detaylı Bilgi</a>
          </div>
          </div>
    </div>

         
        }
      </div>
    </div>

  </div>
</div>
