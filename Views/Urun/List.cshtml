@{
    Layout = "_AdminLayout";
}

@model List<Urun>


<section id="ProductList">
  <form method="get" class="mb-3 d-flex justify-content-end">
    <div class="input-group">

        <select name="kategori" class="form-select bg-white text-dark border-secondary" asp-items="ViewBag.Kategoriler">
            <option value="">Hepsi</option>
        </select>

        <button type="submit" class="btn btn-dark text-white">
            <i class="fa-solid fa-magnifying-glass"></i> Ara
        </button>
        
    </div>

</form>

<div class="mb-3 d-flex justify-content-end">
    <a asp-controller="Urun" asp-action="Create" class="btn btn-dark shadow-sm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Ürün Ekle
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th style="width: 30px;">Id</th>
                <th style="width: 80px;">Resim</th>
                <th>Ürün Adı</th>
                <th>Fiyat</th>
                <th>Aktif</th>
                <th>Anasayfa</th>
                <th>Kategori</th>
                <th style="width: 90px;"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var urun in Model)
            {
                <tr>
                    <td>@urun.Id</td>
                    <td>
                        <div style="width: 80px; height: 80px; overflow: hidden; border-radius: 0.25rem;">
                            <img src="/images/@urun.ResimUrl" 
                                class="img-fluid" 
                                alt=""
                                style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                    </td>
                    <td>@urun.UrunAdi</td>
                    <td>@urun.Fiyat ₺</td>
                    <td>
                        @if (urun.Aktif)
                        {
                            <i class="fa-solid fa-circle-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-xmark text-danger"></i>
                        }
                    </td>
                    <td>
                        @if (urun.Anasayfa)
                        {
                            <i class="fa-solid fa-circle-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-xmark text-danger"></i>
                        }
                    </td>
                    <td>@urun.Kategori.KategoriAdi</td>
                    <td>
                        <a asp-controller="Urun" asp-action="Edit" asp-route-id="@urun.Id"
                            class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-controller="Urun" asp-action="Delete" asp-route-id="@urun.Id"
                            class="btn btn-danger btn-sm">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

</section>