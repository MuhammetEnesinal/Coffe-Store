
@{
    Layout = "_AdminLayout";
}

@model IEnumerable<AppUser>



<section id="UserList">

 <form method="get" class="mb-3 d-flex justify-content-end">
    <div class="input-group">

        <select name="role" class="form-select bg-white text-dark border-secondary" asp-items="ViewBag.Roles">
            <option value="" selected>Hepsi</option>
        </select>

        <button type="submit" class="btn btn-dark text-white">
            <i class="fa-solid fa-magnifying-glass"></i> Ara
        </button>
        
    </div>
</form>

<div class="mb-3 d-flex justify-content-end">
    <a asp-controller="User" asp-action="Create" class="btn btn-dark shadow-sm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Kullanici Ekle
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle text-center">
        <thead class="table-dark">
            <tr>
                <th >Id</th>
                <th>Username</th>
                <th>Email</th>             
                <th style="width: 90px;"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.AdSoyad</td>
                    <td>@user.Email</td>
                   
                    
                    <td>
                        <a asp-controller="User" asp-action="Edit" asp-route-id="@user.Id"
                            class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-controller="User" asp-action="Delete" asp-route-id="@user.Id"
                            class="btn btn-danger btn-sm">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</section>