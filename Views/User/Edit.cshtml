@{

    Layout = "_AdminLayout";
}

@model UserEditModel


<section id="userEdit">
<div class="container py-5">
    <div class="row justify-content-center ">
        <div class="col-md-6  border border-secondary rounded-3 p-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h4 class="mb-0 fw-semibold">Kullanıcı Güncelle</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4" asp-validation-summary="All" class="text-danger"></div>
                    <form asp-action="Edit" method="post">
                        <div class="mb-3">
                            <label asp-for="AdSoyad" class="form-label fw-semibold"></label>
                            <input asp-for="AdSoyad" class="form-control" placeholder="Ad Soyad giriniz..." />
                            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="Email giriniz..." />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        
                         <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="Parola giriniz..." />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                         <div class="mb-3">
                            <label asp-for="PasswordConfirm" class="form-label fw-semibold"></label>
                            <input asp-for="PasswordConfirm" class="form-control" placeholder="Parola tekrar giriniz..." />
                            <span asp-validation-for="PasswordConfirm" class="text-danger small"></span>
                        </div>

                            <div class="Card mb-3  border-secondary shadow-sm">
                                <div class="Card-header">
                                    <h5>Roller</h5>
                                </div>
                                <div class="Card-body">
                                    <div class="mb-3">
                                        @foreach(var role in ViewBag.Roles){
                                            <div class="form-check  mb-2">
                                                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="@role"  @(Model.SelectedRoles!.Any(r => r == role) ? "checked" : "") />
                                                <label class="form-check-label">@role</label>
                                            </div>  
                                        }
                                    </div>
                                </div>
                            </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
</section>
        